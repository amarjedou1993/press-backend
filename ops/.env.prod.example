# .env — production secrets. NEVER commit this file.
#   cp .env.prod.example .env && chmod 600 .env

APP_VERSION=latest

# ── database ──
DB_NAME=press_accreditation
DB_USER=press
DB_PASSWORD=                      # generate: openssl rand -base64 32

# ── host paths (must exist and be writable by the container user) ──
HOST_STORAGE_DIR=/var/lib/press-accreditation/storage
HOST_KEYS_DIR=/etc/press-accreditation/keys

# ── bootstrap administrator ──
ADMIN_EMAIL=admin@hapa.mr
ADMIN_INITIAL_PASSWORD=           # change at first login

# ── URLs ──
FRONTEND_ORIGIN=https://presse.hapa.mr
PUBLIC_API_URL=https://presse.hapa.mr/api
REVALIDATE_URL=http://frontend:3000/api/revalidate
REVALIDATE_TOKEN=                 # generate: openssl rand -hex 32

# ── SMTP ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
